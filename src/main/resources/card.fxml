<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="170.0" prefWidth="250.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.cardController">
   <children>
      <VBox alignment="CENTER" prefHeight="194.0" prefWidth="360.0">
         <children>
            <Label fx:id="cardText" alignment="CENTER" prefHeight="169.0" prefWidth="360.0" stylesheets="@style.css" text="this will hold the question or answer of the card" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="Bell MT" size="14.0" />
               </font>
            </Label>
            <Button fx:id="showAnswerButton" mnemonicParsing="false" onAction="#setCardAnswer" text="Show answer">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
               <font>
                  <Font name="Bell MT" size="12.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
   <styleClass>
      <String fx:value="cardItem" />
      <String fx:value="shadow" />
   </styleClass>
</AnchorPane>
