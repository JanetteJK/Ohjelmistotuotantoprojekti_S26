<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="170.0" prefWidth="250.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CardController">
   <children>
      <VBox alignment="CENTER" prefHeight="194.0" prefWidth="360.0">
         <children>
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox prefHeight="38.0" prefWidth="158.0">
                     <children>
                        <Label fx:id="cardCategory" alignment="CENTER" prefHeight="50.0" prefWidth="158.0" text="Category is here" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font name="Bell MT" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label fx:id="cardText" alignment="CENTER" prefHeight="179.0" prefWidth="360.0" stylesheets="@style.css" text="this will hold the question or answer of the card" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="Bell MT" size="14.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox prefHeight="38.0" prefWidth="131.0">
                     <children>
                        <HBox alignment="CENTER" prefHeight="38.0" prefWidth="121.0">
                           <children>
                              <Button fx:id="showAnswerButton" alignment="CENTER" mnemonicParsing="false" onAction="#setCardAnswer" prefHeight="22.0" prefWidth="114.0" styleClass="shadow" stylesheets="@style.css" text="%ELEM_show_answer" textAlignment="CENTER" wrapText="true">
                                 <font>
                                    <Font name="Bell MT" size="12.0" />
                                 </font>
                              </Button>
                           </children>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="38.0" prefWidth="140.0">
                     <children>
                        <Button fx:id="deleteCardButton" alignment="CENTER" mnemonicParsing="false" onAction="#deleteCard" prefHeight="22.0" prefWidth="117.0" styleClass="shadow" stylesheets="@style.css" text="%ELEM_delete" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font name="Bell MT" size="12.0" />
                           </font>
                        </Button>
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <styleClass>
      <String fx:value="cardItem" />
      <String fx:value="shadow" />
   </styleClass>
</AnchorPane>
