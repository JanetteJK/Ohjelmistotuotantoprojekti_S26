<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="170.0" prefWidth="250.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.cardController">
   <children>
      <VBox alignment="CENTER" prefHeight="194.0" prefWidth="360.0">
         <children>
            <Label fx:id="cardText" alignment="CENTER" prefHeight="82.0" prefWidth="360.0" text="this will hold the question or answer of the card">
               <font>
                  <Font name="Bell MT" size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
   <styleClass>
      <String fx:value="cardItem" />
      <String fx:value="shadow" />
   </styleClass>
</AnchorPane>
