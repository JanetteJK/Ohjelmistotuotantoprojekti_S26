CREATE DATABASE flashers_application;
CREATE USER 'flashcard_team'@'localhost' IDENTIFIED BY 'salasana';
GRANT ALL PRIVILEGES ON flashers_application.* TO 'flashcard_team'@'localhost';

CREATE TABLE users (
   user_id INT AUTO_INCREMENT NOT NULL,
   username VARCHAR (80) NOT NULL,
   passwd VARCHAR (255) NOT NULL,
   email VARCHAR (255) NOT NULL,
   role ENUM('student','teacher') NOT NULL,
   PRIMARY KEY(user_id)
);

CREATE TABLE flashcards (
   fc_id INT AUTO_INCREMENT NOT NULL,
   user_id INT NOT NULL,
   question VARCHAR (500) NOT NULL,
   answer VARCHAR (500) NOT NULL, 
   category VARCHAR (255) NULL,
   PRIMARY KEY(fc_id)
);

ALTER TABLE flashcards ADD CONSTRAINT fk_user_id FOREIGN KEY (user_id) REFERENCES users(user_id);

CREATE TABLE study_materials (
   sm_id INT AUTO_INCREMENT NOT NULL,
   user_id INT NOT NULL,
   materials VARCHAR (255) NOT NULL,
   category VARCHAR (255) NULL, 
   PRIMARY KEY(sm_id)
);

ALTER TABLE study_materials ADD CONSTRAINT sm_user_id FOREIGN KEY (user_id) REFERENCES users(user_id);

CREATE TABLE quizz_points (
   quizz_id INT AUTO_INCREMENT NOT NULL,
   user_id INT NOT NULL,
   quizz_length INT NOT NULL,
   quizz_points INT NOT NULL, 
   PRIMARY KEY(quizz_id)
);

ALTER TABLE quizz_points ADD CONSTRAINT quizz_user_id FOREIGN KEY (user_id) REFERENCES users(user_id);
